# Development only. Prefer: python scripts/init_env.py
# Never commit .env or use these placeholders in a deployed environment.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
JWT_SIGNING_KEY=replace-with-a-different-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_HSTS_SECONDS=0
TRUST_PROXY_HEADERS=false
POSTGRES_DB=dms
POSTGRES_USER=dms
POSTGRES_PASSWORD=replace-with-a-random-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_PASSWORD=replace-with-a-random-password
REDIS_URL=redis://:replace-with-a-random-password@redis:6379/0
REDIS_CACHE_URL=redis://:replace-with-a-random-password@redis:6379/1
MINIO_ROOT_USER=dms-root
MINIO_ROOT_PASSWORD=replace-with-a-random-password
S3_ACCESS_KEY=dms-app
S3_SECRET_KEY=replace-with-a-random-password
S3_BUCKET=documents
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_ADDRESSING_STYLE=path
OCR_LANGUAGES=eng+fas
MAX_UPLOAD_BYTES=26214400
MAX_OCR_PAGES=20
MAX_OCR_PIXELS=20000000
MAX_OCR_CHARS=200000
OCR_PAGE_TIMEOUT=45
LOG_LEVEL=INFO
API_PORT=8000
MINIO_CONSOLE_PORT=9001
